# NodeFeeds Environment Variables
# Add these in Railway → Variables tab. NEVER commit .env to GitHub.

# Core
ANTHROPIC_API_KEY=your_claude_api_key_here
ADSENSE_PUBLISHER_ID=pub-1364508722231350
SITE_NAME=NodeFeeds
SITE_URL=https://nodefeeds.com
SITE_TAGLINE=AI & Tech Intelligence, Delivered Fresh
PORT=3000

# Images — get free key at unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# X (Twitter) — get from developer.twitter.com
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret
